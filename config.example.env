# Copy to config.local.env (gitignored) and set the values for this machine.
#
#   cp config.example.env config.local.env

# Absolute path of this team's private vault clone.
# CURSOR_DOCS_VAULT="$HOME/cursor-docs"

# Git URL used by setup when that path does not exist yet.
# CURSOR_DOCS_VAULT_URL="git@github.com:my-org/cursor-docs.git"

# Engine checkout. Defaults to this repository.
# CURSOR_DOCS_ENGINE="/absolute/path/to/cursor-docs-vault"

# Colon-separated directories scanned by: ./bootstrap.sh discover
# CURSOR_DOCS_DISCOVER_ROOTS="$HOME/src:$HOME/work"

# How deep find looks for .git (default 3).
# CURSOR_DOCS_DISCOVER_MAXDEPTH=3

# Reported by status. ssh or https.
# CURSOR_DOCS_GIT_TRANSPORT=ssh
